@startuml
title Diagrama de Secuencia DOO: C-03 Importar datos masivamente (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 25
skinparam BoxPadding 12
autonumber

actor Administrador
participant "Sistema (Interfaz)" as Sistema
participant "csvParser"          as Parser
participant "edificio : Edificio"     as Edificio
participant "facultad : Facultad"     as Facultad
participant "carrera : Carrera"       as Carrera
participant "periodo : Periodo"       as Periodo
participant "asignatura : Asignatura" as Asignatura
participant "profesor : Profesor"     as Profesor
participant "comision : Comision"     as Comision

Administrador -> Sistema : ingresa a Estructura Academica
activate Sistema
Sistema --> Administrador : muestra entidades y botones
deactivate Sistema

Administrador -> Sistema : "Importar CSV" y selecciona el archivo
activate Sistema

' ── Validacion en cliente (cadena de 6 pasos) ──
Sistema -> Parser : validarFormatoArchivo(archivo)
activate Parser
Parser --> Sistema : formato OK
deactivate Parser
Sistema -> Parser : parsearCSV(archivo)
activate Parser
Parser --> Sistema : filas
deactivate Parser
Sistema -> Parser : validarEsquema(filas)
activate Parser
Parser --> Sistema : esquema OK
deactivate Parser
Sistema -> Parser : detectarDuplicados(filas)
activate Parser
Parser --> Sistema : sin duplicados
deactivate Parser
Sistema -> Parser : detectarIncompletos(filas)
activate Parser
Parser --> Sistema : sin incompletos
deactivate Parser
Sistema -> Parser : detectarFormatosInvalidos(filas)
activate Parser
Parser --> Sistema : formatos OK
deactivate Parser

' ── Insercion por entidad, respetando dependencias (FK) ──
note over Sistema, Comision
  El orquestador inserta en orden de dependencias:
  Edificio -> Facultad -> Carrera -> Periodo -> Asignatura -> Profesor -> Comision
end note

Sistema -> Edificio : insertar(filas)
activate Edificio
Edificio --> Sistema : edificios insertados
deactivate Edificio
Sistema -> Facultad : insertar(filas)
activate Facultad
Facultad --> Sistema : facultades insertadas
deactivate Facultad
Sistema -> Carrera : insertar(filas)
activate Carrera
Carrera --> Sistema : carreras insertadas
deactivate Carrera
Sistema -> Periodo : insertar(filas)
activate Periodo
Periodo --> Sistema : periodos insertados
deactivate Periodo
Sistema -> Asignatura : insertar(filas)
activate Asignatura
Asignatura --> Sistema : asignaturas insertadas
deactivate Asignatura
Sistema -> Profesor : insertar(filas)
activate Profesor
Profesor --> Sistema : profesores insertados
deactivate Profesor
Sistema -> Comision : insertar(filas)
activate Comision
Comision --> Sistema : comisiones insertadas
deactivate Comision

Sistema --> Administrador : "Archivo importado con exito"
deactivate Sistema

@enduml
