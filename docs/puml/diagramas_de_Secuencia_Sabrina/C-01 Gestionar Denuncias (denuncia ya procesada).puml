@startuml

title Diagrama de Secuencia: C-01 Gestionar Denuncia (Alt: Denuncia ya gestionada)

skinparam style strictuml
skinparam ParticipantPadding 30
skinparam BoxPadding 12

autonumber

actor Administrador
participant "Sistema\n(DenunciasPage)" as Interfaz
participant "Denuncia"                   as Denuncia

Administrador -> Interfaz: Ingresa al panel administrativo y hace click en "Denuncias"
activate Interfaz
Interfaz -> Denuncia: Solicita lista de Denuncias
activate Denuncia
Denuncia -> Denuncia: obtenerDenuncias()
loop por cada denuncia de la lista
  Denuncia -> Usuario: Solicita datos del receptor_id
  activate Usuario
  Usuario -> Usuario: obtenerPorId(receptor_id)
  Usuario --> Denuncia: Devuelve datos del receptor_id
  deactivate Usuario
end
Denuncia --> Interfaz: Devuelve lista de Denuncias
deactivate Denuncia
Interfaz --> Administrador: Muestra listado de Denuncias
deactivate Interfaz
Administrador -> Interfaz: Hace click en "Abrir" de un Denuncia
activate Interfaz
Interfaz -> Denuncia: Solicita detalle de la Denuncia
activate Denuncia
Denuncia -> Denuncia: obtenerDetalleDenuncia(id_denuncia)
opt emisor_id != null
  Denuncia -> Usuario: Solicita datos del emisor_id
  activate Usuario
  Usuario -> Usuario: obtenerPorId(emisor_id)
  Usuario --> Denuncia: Devuelve datos de emisor_id
  deactivate Usuario
end
Denuncia -> Usuario: Solicita datos del receptor
Usuario -> Usuario: obtenerPorId(receptor_id)
Usuario --> Denuncia: Devuelve datos del receptor
deactivate Usuario

Denuncia --> Interfaz: Devuelve detalle del Denuncia
deactivate Denuncia
Interfaz -> Interfaz: setIsDenunciaModalOpen(true)
Interfaz --> Administrador: Muestra modal para resolver el Denuncia
deactivate Interfaz
Administrador -> Interfaz: Selecciona acción y hace click en "Confirmar"
activate Interfaz
Interfaz -> Denuncia: Solicita resolver Denuncia
activate Denuncia
Denuncia -> Usuario: Solicita id_admin de la sesión
activate Usuario
Usuario -> Usuario: obtenerAdminSesion()
Usuario --> Denuncia: Devuelve admin_id
deactivate Usuario
Denuncia -> Denuncia: resolverDenuncia(id_denuncia, {estado="Resuelto", accion, fechaHasta, observaciones, admin_id})
Denuncia --> Interfaz: Error: Denuncia ya gestionada
deactivate Denuncia
Interfaz --> Administrador: "Hubo un error al resolver la denuncia. Denuncia ya gestionada."

deactivate Interfaz

@enduml