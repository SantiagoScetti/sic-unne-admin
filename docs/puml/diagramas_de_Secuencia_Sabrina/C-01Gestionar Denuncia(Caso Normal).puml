@startuml
title Diagrama de Secuencia: C-01 Gestionar Denuncia (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 30
skinparam BoxPadding 12

autonumber

actor Administrador
participant "Sistema\n(DenunciasPage)" as Interfaz
participant "Denuncia" as Denuncia
participant "Usuario" as Usuario

' ─── Listado ─────────────────────────────────────────────────────────────
Administrador -> Interfaz: Ingresa al panel y hace clic en "Denuncias"
activate Interfaz
Interfaz -> Denuncia: Solicita listado de Denuncias 
activate Denuncia
Denuncia -> Denuncia: obtenerDenuncias()

loop por cada denuncia de la lista
  Denuncia -> Usuario: Solicita datos del receptor_id
  activate Usuario
  Usuario -> Usuario: obtenerPorId(receptor_id)
  Usuario --> Denuncia: Devuelve datos del receptor_id
  deactivate Usuario
end

Denuncia --> Interfaz: Devuelve lista de denuncias (con datos del denunciado)
deactivate Denuncia

Interfaz --> Administrador: Muestra listado de denuncias
deactivate Interfaz

' ─── Detalle (modal) ─────────────────────────────────────────────────────
Administrador -> Interfaz: Clic en "Abrir" de una denuncia
activate Interfaz

Interfaz -> Denuncia: Solicita detalle de la Denuncia
activate Denuncia
Denuncia -> Denuncia: obtenerDetalleDenuncia(id_denuncia)

opt emisor_id != null
  Denuncia -> Usuario: Solicita datos del emisor_id
  activate Usuario
  Usuario -> Usuario: obtenerPorId(emisor_id)
  Usuario --> Denuncia: Devuelve datos de emisor_id
  deactivate Usuario
end

Denuncia -> Usuario: Solicita datos del receptor_id
activate Usuario

Usuario -> Usuario: obtenerPorId(receptor_id)
Usuario --> Denuncia: Devuelve datos de receptor_id
deactivate Usuario

Denuncia --> Interfaz: Devuelve detalle de la denuncia
deactivate Denuncia

Interfaz -> Interfaz: setIsDenunciaModalOpen(true)
Interfaz --> Administrador: Muestra modal de detalle de la denuncia
deactivate Interfaz

' ─── Resolver ────────────────────────────────────────────────────────────
Administrador -> Interfaz: Selecciona acción y confirma
activate Interfaz

Interfaz -> Denuncia: Solicita resolver Denuncia
activate Denuncia

Denuncia -> Usuario: Solicita id_admin de la sesión
activate Usuario
Usuario -> Usuario: obtenerAdminPorDefecto()
Usuario --> Denuncia: Devuelve admin_id
deactivate Usuario
Denuncia -> Denuncia: resolverDenuncia(id_denuncia, {estado, accion, fechaHasta, observaciones, admin_id})


opt accion implica suspensión
  Denuncia -> Usuario: Solicita suspender usuario
  activate Usuario
  Usuario -> Usuario: suspender(receptor_id, fechaHasta)
  Usuario --> Denuncia: Usuario suspendido
  deactivate Usuario
end

Denuncia --> Interfaz: Denuncia resuelta
deactivate Denuncia

Interfaz --> Administrador: "Denuncia resuelta con éxito"
deactivate Interfaz
@enduml