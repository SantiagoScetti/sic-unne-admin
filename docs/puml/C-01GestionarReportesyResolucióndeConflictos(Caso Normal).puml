@startuml

title Diagrama de Secuencia: C-01 Gestionar Reportes y Resolucion de Conflictos (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 40
skinparam BoxPadding 20

autonumber

actor Administrador

participant "Sistema\n(Interfaz)"        as Interfaz
participant "Reporte"                    as R
participant "Usuario"                    as U
participant "AuditoriaAdministrativa"    as A
participant "Notificacion"               as N

Administrador -> Interfaz: ingresa al panel de reportes
activate Interfaz

Interfaz -> R: obtenerReportes()
activate R
R -> R: consulta todos los reportes con datos de usuarios
Interfaz <-- R: lista_reportes
deactivate R

Interfaz --> Administrador: se muestra lista y opciones de filtrado
deactivate Interfaz

Administrador -> Interfaz: selecciona filtro "Pendiente"
activate Interfaz

Interfaz -> R: obtenerReportesFiltrados("Pendiente")
activate R
R -> R: filtra reportes por estado
Interfaz <-- R: reportes_filtrados
deactivate R

Interfaz --> Administrador: se muestra lista filtrada
deactivate Interfaz

Administrador -> Interfaz: hace click en un reporte
activate Interfaz

Interfaz -> R: obtenerDetalleReporte(id_reporte)
activate R
R -> R: busca reporte por id con datos relacionados
Interfaz <-- R: detalle_reporte
deactivate R

Interfaz --> Administrador: se muestra detalle completo
deactivate Interfaz

Administrador -> Interfaz: selecciona accion y resuelve
activate Interfaz

Interfaz -> R: actualizarEstado(id_reporte, "Resuelto", resolucion)
activate R
R -> R: actualiza estado y resolucion del reporte
Interfaz <-- R: estado_actualizado
deactivate R

Interfaz -> U: actualizarFechaSuspension(receptor_id, duracion)
activate U
U -> U: registra suspension del usuario reportado
Interfaz <-- U: suspension_registrada
deactivate U

Interfaz -> A: registrar(id_reporte, accion, admin_id)
activate A
A -> A: inserta registro en auditoria administrativa
Interfaz <-- A: auditoria_registrada
deactivate A

Interfaz -> N: notificar(emisor_id, receptor_id)
activate N
N -> N: inserta notificaciones para ambos usuarios
Interfaz <-- N: notificaciones_enviadas
deactivate N

Interfaz --> Administrador: "Reporte actualizado"
deactivate Interfaz

@enduml