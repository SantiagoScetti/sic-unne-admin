@startuml
title Diagrama de Secuencia (DOO) - C-01 Gestionar Reporte y Resolucion de Conflictos (Caso Normal)

' Estilo orientado a objetos: lineas de vida = objetos del dominio.
' No se muestran capas tecnicas (frontend/backend/DB) ni HTTP ni SQL.
' La flecha Interfaz -> ServicioResolucionReporte se realiza en el codigo via
' reporteApi.resolverReporte() + API Route + servicio.resolver() (plomeria, no se dibuja).

skinparam style strictuml
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Administrador as Admin

participant "Sistema\n(Interfaz)"            as UI
participant ":ServicioResolucionReporte"     as Serv
participant "reporte:Reporte"                as Rep
participant "estado:EstadoPendiente"         as Est
participant ":ReporteRepositorio"            as RepoR
participant ":UsuarioRepositorio"            as RepoU
participant ":NotificacionRepositorio"       as RepoN
participant ":AuditoriaRepositorio"          as RepoA

Admin -> UI : selecciona reporte y elige accion
activate UI
UI -> Serv : resolver(id_reporte, accion, fechaHasta, observaciones)
activate Serv

Serv -> RepoR : obtenerPorId(id_reporte)
activate RepoR
RepoR --> Serv : reporte
deactivate RepoR

Serv -> RepoU : obtenerAdminPorDefecto()
activate RepoU
RepoU --> Serv : id_admin
deactivate RepoU

Serv -> Rep : resolver(accion)
activate Rep
Rep -> Est : resolver(reporte, accion)
activate Est
Est -> Rep : registrarAccion(accion)
Est -> Rep : transicionarA(EstadoResuelto)
Est --> Rep
deactivate Est
Rep --> Serv : reporte resuelto
deactivate Rep

Serv -> Rep : asignarAdmin(id_admin)
Serv -> RepoR : guardar(reporte)
activate RepoR
RepoR --> Serv : reporte guardado
deactivate RepoR

Serv -> RepoU : suspender(receptor_id, fechaHasta)
activate RepoU
RepoU --> Serv : usuario suspendido
deactivate RepoU

Serv -> RepoN : crearVarias(notificaciones)
activate RepoN
RepoN --> Serv : notificaciones creadas
deactivate RepoN

Serv -> RepoA : registrar(id_admin, accion, id_reporte)
activate RepoA
RepoA --> Serv : auditoria registrada
deactivate RepoA

Serv --> UI : reporte resuelto
deactivate Serv
UI --> Admin : "Accion aplicada con exito"
deactivate UI

@enduml
