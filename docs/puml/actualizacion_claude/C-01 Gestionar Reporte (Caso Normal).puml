@startuml

title Diagrama de Secuencia: C-01 Gestionar Reporte (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 30
skinparam BoxPadding 12

autonumber

actor Administrador

box "Presentacion" #LightBlue
  participant "Sistema\n(ReportesPage)" as Interfaz
end box

box "Servicios HTTP" #LightYellow
  participant "reporte.service" as Service
end box

box "Controlador" #Lavender
  participant "API\n(/api/reportes/[id])" as API
end box

box "Dominio" #LightGreen
  participant "ServicioResolucionReporte" as Servicio
  participant "Reporte"                   as Reporte
  participant "Usuario"                   as Usuario
  participant "AuditoriaAdministrativa"   as Auditoria
  participant "Notificacion"              as Notificacion
end box

Administrador -> Interfaz: Selecciona reporte y elige accion
activate Interfaz
Interfaz -> Service: resolverReporte(id, { estado:'Resuelto', accion, fechaHasta, observaciones })
activate Service
Service -> API: PATCH /api/reportes/:id\n{ estado, accion, fechaHasta, observaciones }
activate API
API -> Servicio: resolver({ id, accion, fechaHasta, observaciones })
activate Servicio

Servicio -> Reporte: obtenerPorId(id)
activate Reporte
Reporte --> Servicio: Reporte (estado = 'Pendiente')
deactivate Reporte

note right of Reporte
  (Patron Estado)
  Valida que el estado actual
  permita la transicion.
  Registra la accion tomada
  y transiciona a 'Resuelto'.
end note

Servicio -> Reporte: resolver(accion)
activate Reporte
Reporte --> Servicio: Reporte resuelto
deactivate Reporte

Servicio -> Reporte: guardar()
activate Reporte
Reporte --> Servicio: Reporte guardado
deactivate Reporte

note right of Servicio
  (Patron Estrategia)
  Selecciona el efecto concreto
  segun la accion elegida:
  Enviar aviso / Suspender
  Temporalmente / Indefinidamente.
end note

Servicio -> Usuario: suspender(receptor_id, fechaHasta)
activate Usuario
Usuario --> Servicio: Suspencion aplicada
deactivate Usuario

note right of Servicio
  (Patron Observador)
  Publica ReporteResueltoEvent.
  Los listeners notifican a los
  usuarios y registran la auditoria.
end note

Servicio -> Notificacion: crearVarias(emisor_id, receptor_id, mensaje)
activate Notificacion
Notificacion --> Servicio: Notificaciones creadas
deactivate Notificacion

Servicio -> Auditoria: registrar(admin_id, accion, id_reporte)
activate Auditoria
Auditoria --> Servicio: Auditoria registrada
deactivate Auditoria

Servicio --> API: Reporte resuelto
deactivate Servicio
API --> Service: 200 { data: { estado:'Resuelto', accion_tomada } }
deactivate API
Service --> Interfaz: Reporte resuelto
deactivate Service
Interfaz --> Administrador: "Accion aplicada con exito"
deactivate Interfaz

@enduml
