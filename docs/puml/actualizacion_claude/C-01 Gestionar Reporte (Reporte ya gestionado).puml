@startuml
title Diagrama de Secuencia (DOO) - C-01 Gestionar Reporte (Alternativo: reporte ya gestionado)

' El reporte llega en estado Resuelto: su objeto-estado (EstadoResuelto) no permite
' la transicion y lanza ReporteYaProcesadoError, que se propaga hasta la interfaz.

skinparam style strictuml
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Administrador as Admin

participant "Sistema\n(Interfaz)"            as UI
participant ":ServicioResolucionReporte"     as Serv
participant "reporte:Reporte"                as Rep
participant "estado:EstadoResuelto"          as Est
participant ":ReporteRepositorio"            as RepoR

Admin -> UI : intenta resolver un reporte ya gestionado
activate UI
UI -> Serv : resolver(id_reporte, accion)
activate Serv

Serv -> RepoR : obtenerPorId(id_reporte)
activate RepoR
RepoR --> Serv : reporte (estado = Resuelto)
deactivate RepoR

Serv -> Rep : resolver(accion)
activate Rep
Rep -> Est : resolver(reporte, accion)
activate Est
Est --> Rep : throw ReporteYaProcesadoError
deactivate Est
Rep --> Serv : throw ReporteYaProcesadoError
deactivate Rep

Serv --> UI : ReporteYaProcesadoError (estadoActual = Resuelto)
deactivate Serv
UI --> Admin : "Este reporte ya fue procesado por otro administrador"
deactivate UI

@enduml
