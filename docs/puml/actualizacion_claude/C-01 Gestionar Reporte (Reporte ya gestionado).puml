@startuml

title Diagrama de Secuencia: C-01 Gestionar Reporte (Alt: Reporte ya gestionado)

skinparam style strictuml
skinparam ParticipantPadding 30
skinparam BoxPadding 12

autonumber

actor Administrador

box "Presentacion" #LightBlue
  participant "Sistema\n(ReportesPage)" as Interfaz
end box

box "Servicios HTTP" #LightYellow
  participant "reporte.service" as Service
end box

box "Controlador" #Lavender
  participant "API\n(/api/reportes/[id])" as API
end box

box "Dominio" #LightGreen
  participant "ServicioResolucionReporte" as Servicio
  participant "Reporte"                   as Reporte
end box

Administrador -> Interfaz: Intenta resolver un reporte ya gestionado
activate Interfaz
Interfaz -> Service: resolverReporte(id, { estado:'Resuelto', accion })
activate Service
Service -> API: PATCH /api/reportes/:id\n{ estado:'Resuelto', accion }
activate API
API -> Servicio: resolver({ id, accion })
activate Servicio

Servicio -> Reporte: obtenerPorId(id)
activate Reporte
Reporte --> Servicio: Reporte (estado = 'Resuelto')
deactivate Reporte

note right of Reporte
  (Patron Estado)
  EstadoResuelto es terminal:
  rechaza la transicion y lanza
  ReporteYaProcesadoError.
  No se realiza ninguna escritura.
end note

Servicio -> Reporte: resolver(accion)
activate Reporte
Reporte --> Servicio: throw ReporteYaProcesadoError
deactivate Reporte

Servicio --> API: propaga ReporteYaProcesadoError
deactivate Servicio
API --> Service: 409 Conflict\n{ error: 'El reporte ya fue procesado', estadoActual }
deactivate API
Service --> Interfaz: throw error (409)
deactivate Service
Interfaz --> Administrador: "Este reporte ya fue procesado por otro administrador"
deactivate Interfaz

@enduml
