@startuml

title Diagrama de Secuencia: C-03 Importar datos masivamente (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 30
skinparam BoxPadding 12

autonumber

actor Administrador

box "Presentacion" #LightBlue
  participant "Sistema\n(EstructuraPage)" as Interfaz
  participant "csvParser"                 as Parser
end box

box "Servicios HTTP" #LightYellow
  participant "comision.service" as Service
end box

box "Controlador" #Lavender
  participant "API\n(/api/comisiones)" as API
end box

box "Dominio" #LightGreen
  participant "Asignatura"       as Asignatura
  participant "Comision"         as Comision
  participant "ComisionProfesor" as ComisionProfesor
end box

Administrador -> Interfaz: Ingresa a estructura academica
activate Interfaz
Interfaz --> Administrador: Se muestran entidades y botones
deactivate Interfaz

Administrador -> Interfaz: Hace click en "Importar CSV"
activate Interfaz
Interfaz --> Administrador: Se abre explorador de archivos
deactivate Interfaz

Administrador -> Interfaz: Selecciona archivo CSV
activate Interfaz

Interfaz -> Parser: validarFormatoArchivo(archivo)
activate Parser
Parser --> Interfaz: ok
deactivate Parser

Interfaz -> Parser: parsearCSV(archivo)
activate Parser
Parser --> Interfaz: filas[]
deactivate Parser

Interfaz -> Parser: validarEsquema(filas)
activate Parser
Parser --> Interfaz: sin errores
deactivate Parser

Interfaz -> Parser: detectarDuplicados(filas)
activate Parser
Parser --> Interfaz: sin errores
deactivate Parser

Interfaz -> Parser: detectarIncompletos(filas)
activate Parser
Parser --> Interfaz: sin errores
deactivate Parser

Interfaz -> Parser: detectarFormatosInvalidos(filas)
activate Parser
Parser --> Interfaz: sin errores
deactivate Parser

Interfaz -> Service: insertar(filas)
activate Service
Service -> API: POST /api/comisiones\n{ filas }
activate API

loop por cada fila del CSV
  API -> Asignatura: obtenerPorNombre(nombre_asignatura)
  activate Asignatura
  Asignatura --> API: Asignatura encontrada
  deactivate Asignatura

  API -> Comision: obtenerPorNombreYAsignatura(nombre, id_asignatura)
  activate Comision
  Comision --> API: existe?
  deactivate Comision

  alt comision no existe
    API -> Comision: crear(nombre, id_asignatura, letraDesde, letraHasta)
    activate Comision
    Comision --> API: Comision creada
    deactivate Comision
  end

  API -> ComisionProfesor: vincular(id_comision, documento_profesor)
  activate ComisionProfesor
  ComisionProfesor --> API: Vinculo registrado
  deactivate ComisionProfesor
end

API --> Service: 200 { insertadas: N, errores: null }
deactivate API
Service --> Interfaz: Resumen importacion
deactivate Service

Interfaz --> Administrador: "Archivo importado con exito"
deactivate Interfaz

@enduml
