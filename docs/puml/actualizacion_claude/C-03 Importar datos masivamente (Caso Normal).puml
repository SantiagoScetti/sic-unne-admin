@startuml
title Diagrama de Secuencia (DOO) - C-03 Importar Datos Masivamente (Caso Normal)

' La Interfaz valida y parsea el CSV con el objeto csvParser (validaciones de
' presentacion). Con las filas validas invoca a ServicioComision.importarMasivo,
' que procesa fila por fila, delegando busquedas y altas en el repositorio y la
' validacion de negocio en la entidad Comision.

skinparam style strictuml
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Administrador as Admin

participant "Sistema\n(Interfaz)"     as UI
participant ":csvParser"             as Parser
participant ":ServicioComision"      as Serv
participant "comision:Comision"      as Com
participant ":ComisionRepositorio"   as Repo

Admin -> UI : selecciona archivo CSV
activate UI

UI -> Parser : validarFormatoArchivo(archivo)
activate Parser
Parser --> UI : ok
deactivate Parser

UI -> Parser : parsearCSV(archivo)
activate Parser
Parser --> UI : filas
deactivate Parser

UI -> Parser : validarEsquema(filas)
UI -> Parser : detectarDuplicados(filas)
UI -> Parser : detectarIncompletos(filas)
UI -> Parser : detectarFormatosInvalidos(filas)
activate Parser
Parser --> UI : sin errores
deactivate Parser

UI -> Serv : importarMasivo(filas)
activate Serv

note over Serv, Repo : Por cada fila del CSV se repiten estos pasos.\nLa comision se crea solo si todavia no existe.

Serv -> Repo : buscarIdAsignaturaPorNombre(asignatura_nombre)
activate Repo
Repo --> Serv : id_asignatura
deactivate Repo

Serv -> Repo : buscarIdComision(comision_nombre, id_asignatura)
activate Repo
Repo --> Serv : id_comision
deactivate Repo

Serv -> Com : new Comision(comision_nombre, letraDesde, letraHasta, id_asignatura)
activate Com
Serv -> Com : validar()
Com --> Serv : ok
deactivate Com

Serv -> Repo : crear(comision)
activate Repo
Repo --> Serv : id_comision
deactivate Repo

Serv -> Repo : buscarIdProfesorPorDocumento(profesor_documento)
activate Repo
Repo --> Serv : id_profesor
deactivate Repo

Serv -> Repo : upsertVinculo(id_comision, id_profesor)
activate Repo
Repo --> Serv : vinculo registrado
deactivate Repo

Serv --> UI : resultado(insertadas, errores)
deactivate Serv
UI --> Admin : "Archivo importado con exito"
deactivate UI

@enduml
