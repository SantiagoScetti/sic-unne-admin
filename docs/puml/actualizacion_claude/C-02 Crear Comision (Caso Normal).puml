@startuml
title Diagrama de Secuencia (DOO) - C-02 Crear Comision (Caso Normal)

' La Interfaz valida los campos del formulario (llamada interna: validarCampos()).
' El ServicioComision orquesta: delega la validacion de negocio en la entidad
' Comision y la persistencia en el repositorio.

skinparam style strictuml
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Administrador as Admin

participant "Sistema\n(Interfaz)"        as UI
participant ":ServicioComision"          as Serv
participant "comision:Comision"          as Com
participant ":ComisionRepositorio"       as Repo

Admin -> UI : completa el formulario y confirma "Crear Comision"
activate UI
UI -> UI : validarCampos()

UI -> Serv : crear(nombre, letraDesde, letraHasta, id_asignatura, profesores_ids)
activate Serv

Serv -> Com : new Comision(nombre, letraDesde, letraHasta, id_asignatura, profesores_ids)
activate Com
Serv -> Com : validar()
Com --> Serv : ok
deactivate Com

Serv -> Repo : existeAsignatura(id_asignatura)
activate Repo
Repo --> Serv : true
deactivate Repo

Serv -> Repo : crear(comision)
activate Repo
Repo --> Serv : id_comision
deactivate Repo

Serv -> Repo : vincularProfesores(id_comision, profesores_ids)
activate Repo
Repo --> Serv : vinculos creados
deactivate Repo

Serv --> UI : comision creada
deactivate Serv
UI --> Admin : "Comision creada con exito"
deactivate UI

@enduml
