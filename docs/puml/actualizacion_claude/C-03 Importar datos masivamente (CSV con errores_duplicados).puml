@startuml
title Diagrama de Secuencia (DOO) - C-03 Importar Datos Masivamente (Alternativo: CSV con errores/duplicados)

' La validacion ocurre en la presentacion, antes de tocar el dominio. Si el objeto
' csvParser detecta errores de esquema, duplicados, incompletos o formatos invalidos,
' la Interfaz informa y NO invoca a ServicioComision (no se realiza ninguna escritura).

skinparam style strictuml
skinparam sequenceMessageAlign center
hide footbox
autonumber

actor Administrador as Admin

participant "Sistema\n(Interfaz)"   as UI
participant ":csvParser"           as Parser

Admin -> UI : selecciona archivo CSV
activate UI

UI -> Parser : validarFormatoArchivo(archivo)
activate Parser
Parser --> UI : ok
deactivate Parser

UI -> Parser : parsearCSV(archivo)
activate Parser
Parser --> UI : filas
deactivate Parser

UI -> Parser : validarEsquema(filas)
activate Parser
Parser --> UI : errores_esquema
deactivate Parser

UI -> Parser : detectarDuplicados(filas)
activate Parser
Parser --> UI : errores_duplicados
deactivate Parser

UI -> Parser : detectarIncompletos(filas)
activate Parser
Parser --> UI : errores_incompletos
deactivate Parser

UI -> Parser : detectarFormatosInvalidos(filas)
activate Parser
Parser --> UI : errores_formato
deactivate Parser

UI --> Admin : muestra mensaje de error especifico (no se invoca el Servicio)
deactivate UI

@enduml
