@startuml

title Diagrama de Secuencia: C-03 Importar datos masivamente (Caso Normal)

skinparam style strictuml
skinparam ParticipantPadding 40
skinparam BoxPadding 20

autonumber

actor Administrador

participant "Sistema\n(Interfaz)" as Interfaz
participant "Edificio"    as ED
participant "Facultad"    as FA
participant "Carrera"     as CA
participant "Periodo"     as PE
participant "Asignatura"  as AS
participant "Profesor"    as PR
participant "Comision"    as CO

Administrador -> Interfaz: Ingresa a estructura academica
activate Interfaz
Interfaz --> Administrador: Se muestran entidades y botones
deactivate Interfaz

Administrador -> Interfaz: Hace click en "Importar CSV"
activate Interfaz
Interfaz --> Administrador: Se abre explorador de archivos
deactivate Interfaz

Administrador -> Interfaz: Selecciona archivo CSV
activate Interfaz

Interfaz -> Interfaz: validarFormatoArchivo(archivo)
Interfaz -> Interfaz: parsearCSV(archivo)
Interfaz -> Interfaz: validarEsquema(filas)
Interfaz -> Interfaz: detectarDuplicados(filas)
Interfaz -> Interfaz: detectarIncompletos(filas)
Interfaz -> Interfaz: detectarFormatosInvalidos(filas)

Interfaz -> ED: Solicita crear Edificios
activate ED
ED -> ED: insertar(filas)
Interfaz <-- ED: Edificios creados
deactivate ED

Interfaz -> FA: Solicita crear Facultades
activate FA
FA -> FA: insertar(filas)
Interfaz <-- FA: Facultades creadas
deactivate FA

Interfaz -> CA: Solicita crear Carreras
activate CA
CA -> CA: insertar(filas)
Interfaz <-- CA: Carreras creadas
deactivate CA

Interfaz -> PE: Solicita crear Periodos
activate PE
PE -> PE: insertar(filas)
Interfaz <-- PE: Periodos creados
deactivate PE

Interfaz -> AS: Solicita crear Asignaturas
activate AS
AS -> AS: insertar(filas)
Interfaz <-- AS: Asignaturas creadas
deactivate AS

Interfaz -> PR: Solicita crear Profesores
activate PR
PR -> PR: insertar(filas)
Interfaz <-- PR: Profesores creados
deactivate PR

Interfaz -> CO: Solicita crear Comisiones
activate CO
CO -> CO: insertar(filas)
Interfaz <-- CO: Comisiones creadas
deactivate CO

Interfaz --> Administrador: "Archivo importado con exito"
deactivate Interfaz

@enduml