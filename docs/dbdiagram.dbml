// =============================================================================
// SIC-UNNE — Diagrama Entidad Relación
// Para usar: pegar este contenido en https://dbdiagram.io/d
// Última actualización: 2026-05-04
// Schema: public (Supabase / PostgreSQL)
// =============================================================================

// ─── GRUPO 1: Organización Académica ─────────────────────────────────────────

Table edificio {
  id_edificio integer [pk, increment]
  nombre      varchar [not null]
  direccion   varchar
  estado      boolean [default: true]
}

Table facultad {
  id_facultad integer [pk, increment]
  nombre      varchar [not null]
  ciudad      varchar
  id_edificio integer [not null]
  estado      boolean [default: true]
}

Table carrera {
  id_carrera  integer [pk, increment]
  nombre      varchar [not null]
  id_facultad integer [not null]
  estado      boolean [default: true]
}

Table periodo {
  id_periodo   integer [pk, increment]
  nombre       varchar [not null]
  fecha_inicio date    [not null]
  fecha_fin    date    [not null]
  estado       boolean [default: true]
}

Table asignatura {
  id_asignatura integer [pk, increment]
  nombre        varchar [not null]
  anio_dictado  varchar
  id_carrera    integer [not null]
  id_periodo    integer [not null]
  estado        boolean [default: true]
}

Table comision {
  id_comision   integer [pk, increment]
  nombre        varchar [not null]
  letra_desde   char(1) [not null]
  letra_hasta   char(1) [not null]
  id_asignatura integer [not null]
  estado        boolean [default: true]
}

// ─── GRUPO 2: Profesores y Horarios ──────────────────────────────────────────

Table profesor {
  id_profesor integer [pk, increment]
  nombre      varchar [not null]
  apellido    varchar [not null]
  documento   integer [not null, unique]
  correo      varchar
  estado      boolean [default: true]
}

// Relación N:M entre comision y profesor
Table comision_profesor {
  id_comision integer [not null]
  id_profesor integer [not null]

  indexes {
    (id_comision, id_profesor) [pk]
  }
}

Table aula {
  id_aula     integer [pk, increment]
  nombre      varchar [not null]
  id_edificio integer [not null]
}

Table horario {
  id_horario  integer [pk, increment]
  dia         varchar [not null]
  hora_inicio time    [not null]
  hora_fin    time    [not null]
  modalidad   varchar
}

// Tabla de asignación: horario + comision + aula
Table horario_comision {
  id_horario  integer [not null]
  id_comision integer [not null]
  id_aula     integer [not null]

  indexes {
    (id_horario, id_comision, id_aula) [pk]
  }
}

// ─── GRUPO 3: Usuarios y Flujo de Intercambio ────────────────────────────────

Table usuario {
  id_usuario integer [pk, increment]
  auth_id    uuid    [unique, note: 'Referencia al usuario en Supabase Auth']
}

Table inscripcion {
  id_inscripcion integer [pk, increment]
  fecha_alta     date    [not null]
  estado         boolean [default: true]
  id_comision    integer [not null]
  id_usuario     integer [not null]
}

Table lista_espera {
  id_lista_espera     integer [pk, increment]
  fecha_alta          date    [not null]
  estado              varchar [not null, note: 'pendiente | aceptada | rechazada | expirada']
  id_usuario          integer [not null]
  id_comision_origen  integer [not null]
  id_comision_destino integer [not null]
}

Table propuesta {
  id_propuesta    integer   [pk, increment]
  fecha_alta      timestamp [not null]
  estado          varchar   [not null, note: 'pendiente | aceptada | rechazada | cancelada']
  id_listaespera_1 integer  [not null]
  id_listaespera_2 integer  [not null]
}

Table respuesta_propuesta {
  id_respuesta     integer   [pk, increment]
  id_propuesta     integer   [not null]
  id_usuario       integer   [not null]
  decision         varchar   [not null, note: 'aceptada | rechazada']
  motivo_rechazo   varchar
  fecha            timestamp [not null]
}

Table comprobante {
  id_comprobante integer   [pk, increment]
  id_propuesta   integer   [not null]
  id_usuario_1   integer   [not null]
  id_usuario_2   integer   [not null]
  fecha_emision  timestamp [not null]
}

Table constancia {
  id_constancia    integer   [pk, increment]
  id_usuario       integer   [not null]
  constancia_url   varchar   [not null]
  fecha_constancia timestamp [not null]
}

// ─── GRUPO 4: Auditoría, Notificaciones y Reportes ───────────────────────────

Table notificacion {
  id_notificacion integer   [pk, increment]
  id_usuario      integer   [not null]
  tipo            varchar   [not null]
  mensaje         varchar   [not null]
  leido           boolean   [default: false]
  fecha           timestamp [not null]
}

Table reporte {
  id_reporte       integer   [pk, increment]
  emisor_id        integer   [not null]
  receptor_id      integer   [not null]
  id_periodo       integer   [not null]
  motivo           varchar   [not null]
  estado           varchar   [not null, note: 'pendiente | resuelto | desestimado']
  fecha_alta       timestamp [not null]
  resolucion_admin text
  accion_tomada    varchar
  admin_id         integer
}

Table auditoria_administrativa {
  id_log                integer   [pk, increment]
  id_admin              integer   [not null]
  id_usuario_afectado   integer   [not null]
  accion                varchar   [not null]
  detalles              json
  fecha                 timestamp [not null]
}

// =============================================================================
// RELACIONES (Foreign Keys)
// =============================================================================

// ── Organización académica ────────────────────────────────────────────────────
Ref: facultad.id_edificio        > edificio.id_edificio
Ref: carrera.id_facultad         > facultad.id_facultad
Ref: asignatura.id_carrera       > carrera.id_carrera
Ref: asignatura.id_periodo       > periodo.id_periodo
Ref: comision.id_asignatura      > asignatura.id_asignatura

// ── Profesores y horarios ─────────────────────────────────────────────────────
Ref: comision_profesor.id_comision > comision.id_comision
Ref: comision_profesor.id_profesor > profesor.id_profesor
Ref: aula.id_edificio              > edificio.id_edificio
Ref: horario_comision.id_horario   > horario.id_horario
Ref: horario_comision.id_comision  > comision.id_comision
Ref: horario_comision.id_aula      > aula.id_aula

// ── Inscripciones y flujo de intercambio ─────────────────────────────────────
Ref: inscripcion.id_comision           > comision.id_comision
Ref: inscripcion.id_usuario            > usuario.id_usuario
Ref: lista_espera.id_usuario           > usuario.id_usuario
Ref: lista_espera.id_comision_origen   > comision.id_comision
Ref: lista_espera.id_comision_destino  > comision.id_comision
Ref: propuesta.id_listaespera_1        > lista_espera.id_lista_espera
Ref: propuesta.id_listaespera_2        > lista_espera.id_lista_espera
Ref: respuesta_propuesta.id_propuesta  > propuesta.id_propuesta
Ref: respuesta_propuesta.id_usuario    > usuario.id_usuario
Ref: comprobante.id_propuesta          > propuesta.id_propuesta
Ref: comprobante.id_usuario_1          > usuario.id_usuario
Ref: comprobante.id_usuario_2          > usuario.id_usuario
Ref: constancia.id_usuario             > usuario.id_usuario

// ── Auditoría, notificaciones y reportes ─────────────────────────────────────
Ref: notificacion.id_usuario                     > usuario.id_usuario
Ref: reporte.emisor_id                           > usuario.id_usuario
Ref: reporte.receptor_id                         > usuario.id_usuario
Ref: reporte.admin_id                            > usuario.id_usuario
Ref: reporte.id_periodo                          > periodo.id_periodo
Ref: auditoria_administrativa.id_admin           > usuario.id_usuario
Ref: auditoria_administrativa.id_usuario_afectado > usuario.id_usuario
